{
  "name": "dsh-livephoto",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Download every image of a Xiaohongshu note, turning Live Photo images into real Apple Live Photo pairs that sync to the iPhone through iCloud.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "xhs.js",
    "helper/main.swift",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "xiaohongshu",
    "live-photo",
    "downloader"
  ],
  "author": {
    "name": "LI",
    "url": "https://github.com/LXD-8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXD-8/dsh-livephoto.git"
  },
  "license": "MIT"
}
